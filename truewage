            alt="TrueWage Logo" 
            className="w-10 h-10 object-contain rounded-2xl bg-white p-1 shadow-lg shadow-teal-500/20" 
          />
          <span className="font-extrabold text-xl tracking-tight text-white">
            TrueWage
          </span>
        </div>

        <div className="flex items-center gap-1 bg-slate-800/90 p-1.5 rounded-2xl border border-slate-700">
          <Globe className="w-4 h-4 text-teal-400 ml-1.5 mr-1" />
          <select
            value={currentLang}
            onChange={(e) => onSelectLang(e.target.value)}
            className="bg-transparent text-xs font-bold text-white focus:outline-none cursor-pointer pr-2 py-0.5"
          >
            {languages.map((l) => (
              <option key={l.code} value={l.code} className="bg-slate-900 text-white">
                {l.flag} {l.native}
              </option>
            ))}
          </select>
        </div>
      </div>

      {/* Hero Body */}
      <div className="max-w-xl w-full mx-auto my-auto py-6 z-10 text-center space-y-5">
        <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-teal-500/20 text-teal-300 border border-teal-500/30 text-xs font-bold shadow-inner">
          <ShieldCheck className="w-4 h-4 text-teal-400" />
          <span>{t.zeroCommission}</span>
        </div>

        {/* Logo and App Title */}
        <div className="space-y-3">
          <div className="flex justify-center">
            <div className="bg-white p-3 sm:p-4 rounded-3xl shadow-2xl shadow-teal-500/20 border border-slate-700/80 max-w-[220px] sm:max-w-[260px] transform hover:scale-105 transition-transform">
              <img 
                src="/truewage-logo.jpg" 
                alt="TrueWage" 
                className="w-full h-auto object-contain mx-auto" 
              />
            </div>
          </div>
          <div className="flex items-center justify-center gap-2 text-base sm:text-lg text-teal-300 font-semibold italic">
            <span>"{t.tagline}"</span>
            <button
              onClick={handleSpeakTagline}
              className={`p-1.5 rounded-full transition-all active:scale-90 flex items-center gap-1 ${
                isSpeakingTagline 
                  ? 'bg-red-500/30 text-red-300 ring-2 ring-red-400 animate-pulse' 
                  : 'bg-slate-800 hover:bg-slate-700 text-teal-300'
              }`}
            >
              {isSpeakingTagline ? <Square className="w-3.5 h-3.5 fill-current" /> : <Volume2 className="w-4 h-4" />}
            </button>
          </div>
          <p className="text-xs sm:text-sm text-slate-400 max-w-md mx-auto leading-relaxed">
            {t.zeroCommissionSubtitle}
          </p>
        </div>

        {/* All Indian Languages Grid */}
        <div className="bg-slate-800/90 p-4 rounded-3xl border border-slate-700 space-y-2.5 text-left">
          <div className="flex items-center justify-between text-xs font-bold text-slate-300">
            <span className="flex items-center gap-1.5">
              <span>🇮🇳</span>
              <span>{t.selectLanguage} (All India Coverage)</span>
            </span>
            <span className="text-[10px] text-teal-400 font-semibold bg-teal-950/80 px-2 py-0.5 rounded-full border border-teal-500/30">
              Active: {languages.find(l => l.code === currentLang)?.name} ({languages.find(l => l.code === currentLang)?.native})
            </span>
          </div>

          <div className="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-5 gap-2 max-h-56 overflow-y-auto pr-1 scrollbar-thin">
            {languages.map((l) => {
              const isSelected = currentLang === l.code;
              return (
                <button
                  key={l.code}
                  onClick={() => onSelectLang(l.code)}
                  className={`p-2.5 rounded-2xl text-xs font-bold flex flex-col items-center gap-1 transition-all relative ${
                    isSelected 
                      ? 'bg-teal-600 text-white shadow-md shadow-teal-600/30 ring-2 ring-teal-400' 
                      : 'bg-slate-900/80 hover:bg-slate-700 text-slate-300 border border-slate-700'
                  }`}
                >
                  <span className="text-base">{l.flag}</span>
                  <span className="leading-tight text-xs font-extrabold">{l.native}</span>
                  <span className="text-[9px] opacity-75">{l.name}</span>
                </button>
              );
            })}
          </div>
        </div>

        {/* REAL MOBILE PHONE + OTP LOGIN CARD */}
        <div className="bg-slate-800/95 p-5 rounded-3xl border border-teal-500/30 shadow-2xl space-y-4 text-left">
          <div className="flex items-center justify-between">
            <h3 className="font-extrabold text-sm sm:text-base text-white flex items-center gap-2">
              <Phone className="w-4 h-4 text-teal-400" />
              <span>{getUi('loginWithPhone', currentLang)}</span>
            </h3>
            <span className="text-[10px] bg-teal-500/20 text-teal-300 font-bold px-2 py-0.5 rounded-full border border-teal-500/30">
              Instant OTP
            </span>
          </div>

          {loginError && (
            <div className="bg-red-500/20 border border-red-500/40 text-red-200 text-xs p-2.5 rounded-xl font-medium">
              {loginError}
            </div>
          )}

          {loginStep === 1 ? (
            <form onSubmit={handleSendLoginOtp} className="space-y-3">
              <div>
                <label className="block text-[11px] font-bold text-slate-300 mb-1">
                  Full Name *
                </label>
                <input
                  type="text"
                  value={loginName}
                  onChange={(e) => setLoginName(e.target.value)}
                  placeholder="e.g. Rahul Sharma"
                  className="w-full p-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-teal-500 placeholder-slate-500"
                  required
                />
