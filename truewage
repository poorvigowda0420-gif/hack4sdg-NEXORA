            </div>

            <div>
              <label className="block font-bold text-slate-300 mb-1">
                {t.customerReg.otpLabel}
              </label>
              <input
                type="text"
                maxLength="4"
                value={otp}
                onChange={(e) => setOtp(e.target.value)}
                placeholder="••••"
                className="w-full p-3.5 rounded-2xl bg-slate-900 border border-slate-700 font-mono text-center tracking-widest text-2xl font-black text-white focus:outline-none focus:ring-2 focus:ring-teal-500 placeholder-slate-600"
                required
              />
            </div>

            <div className="pt-2">
              <label className="flex items-start gap-2.5 cursor-pointer select-none">
                <input
                  type="checkbox"
                  checked={formData.agreeTerms}
                  onChange={(e) => setFormData({...formData, agreeTerms: e.target.checked})}
                  className="w-4 h-4 text-teal-600 rounded bg-slate-900 border-slate-700 mt-0.5"
                  required
                />
                <span className="text-[11px] text-slate-400">
                  I agree to TrueWage Consumer Protection Charter & Zero Middleman Policy.
                </span>
              </label>
            </div>

            <button
              type="submit"
              className="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 rounded-2xl shadow-lg shadow-emerald-600/30 text-sm flex items-center justify-center gap-2 transition-transform active:scale-98"
            >
              <CheckCircle2 className="w-4 h-4" />
              <span>{t.customerReg.completeRegistration}</span>
            </button>
          </form>
        )}
      </div>
    </div>
  );
}

