              </div>

              <button
                type="submit"
                className="w-full bg-teal-600 hover:bg-teal-500 text-white font-black py-3 rounded-xl text-xs flex items-center justify-center gap-2 shadow-lg shadow-teal-600/30 transition-transform active:scale-98"
              >
                <span>{getUi('sendOtp', currentLang)}</span>
                <ArrowRight className="w-4 h-4" />
              </button>
            </form>
          ) : (
            <form onSubmit={handleVerifyLogin} className="space-y-3">
              <div className="bg-teal-950/90 border border-teal-500/40 p-3 rounded-2xl flex items-center justify-between">
                <div>
                  <span className="text-xs text-teal-300 block font-bold">📲 OTP Sent to +91 {loginPhone}</span>
                  <span className="text-[11px] text-teal-200">
                    Code: <strong className="text-white font-mono text-sm tracking-wider">{generatedOtp}</strong>
                  </span>
                </div>
                <button
                  type="button"
                  onClick={() => setLoginOtp(generatedOtp)}
                  className="bg-teal-600 hover:bg-teal-500 text-white text-xs font-bold px-2.5 py-1 rounded-lg"
                >
                  Auto-fill
                </button>
              </div>

              <div>
                <label className="block text-[11px] font-bold text-slate-300 mb-1">
                  {getUi('enterOtp', currentLang)} *
                </label>
                <input
                  type="text"
                  maxLength="4"
                  value={loginOtp}
                  onChange={(e) => setLoginOtp(e.target.value)}
                  placeholder="••••"
                  className="w-full p-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white text-center font-mono text-xl font-black tracking-widest focus:outline-none focus:ring-2 focus:ring-teal-500 placeholder-slate-600"
                  required
                />
              </div>

              <div className="flex gap-2">
                <button
                  type="button"
                  onClick={() => setLoginStep(1)}
                  className="px-3 py-2.5 rounded-xl border border-slate-700 text-slate-400 hover:text-white text-xs font-bold"
                >
                  Change No.
                </button>
                <button
                  type="submit"
                  className="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-black py-2.5 rounded-xl text-xs flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 transition-transform active:scale-98"
                >
                  <CheckCircle2 className="w-4 h-4" />
                  <span>{getUi('verifyAndLogin', currentLang)}</span>
                </button>
              </div>
            </form>
          )}
        </div>

        {/* SECTION DIVIDER */}
        <div className="flex items-center gap-3 pt-2">
          <div className="h-px bg-slate-800 flex-1" />
          <span className="text-[11px] text-slate-400 font-bold uppercase tracking-wider">
            {getUi('orSignUpNew', currentLang)}
          </span>
          <div className="h-px bg-slate-800 flex-1" />
        </div>

        {/* Dedicated Registration Pages Selection */}
        <div className="space-y-3 pt-1">
          <button
            type="button"
            onClick={onOpenCustomerRegister}
            className="w-full group bg-gradient-to-r from-teal-700 to-teal-800 hover:from-teal-600 hover:to-teal-700 p-4 sm:p-5 rounded-3xl text-left border border-teal-500/40 shadow-xl shadow-teal-900/40 transition-all hover:-translate-y-0.5 active:scale-98 flex items-center justify-between"
          >
            <div className="flex items-center gap-3.5">
              <div className="w-11 h-11 rounded-2xl bg-white/20 flex items-center justify-center text-white shrink-0">
                <UserPlus className="w-5 h-5" />
              </div>
              <div>
                <h3 className="font-extrabold text-sm sm:text-base text-white flex items-center gap-2">
                  <span>{t.registerYourselfCustomer}</span>
                </h3>
                <p className="text-xs text-teal-100/80 mt-0.5 line-clamp-1">
                  {t.customerDesc}
                </p>
              </div>
            </div>
            <ArrowRight className="w-5 h-5 text-teal-300 group-hover:translate-x-1 transition-transform shrink-0" />
          </button>

          <button
            type="button"
            onClick={onOpenWorkerRegister}
            className="w-full group bg-gradient-to-r from-amber-700 to-amber-800 hover:from-amber-600 hover:to-amber-700 p-4 sm:p-5 rounded-3xl text-left border border-amber-500/40 shadow-xl shadow-amber-900/40 transition-all hover:-translate-y-0.5 active:scale-98 flex items-center justify-between"
          >
            <div className="flex items-center gap-3.5">
              <div className="w-11 h-11 rounded-2xl bg-white/20 flex items-center justify-center text-white shrink-0">
                <Wrench className="w-5 h-5" />
              </div>
              <div>
                <h3 className="font-extrabold text-sm sm:text-base text-white flex items-center gap-2">
                  <span>{t.registerYourselfWorker}</span>
                </h3>
                <p className="text-xs text-amber-100/80 mt-0.5 line-clamp-1">
                  {t.workerDesc}
                </p>
              </div>
            </div>
            <ArrowRight className="w-5 h-5 text-amber-300 group-hover:translate-x-1 transition-transform shrink-0" />
          </button>
        </div>

        {/* DEMO BUTTON */}
        <div className="pt-2 text-center">
          <button
            type="button"
            onClick={onExploreDemo}
            className="inline-flex items-center gap-2 px-4 py-2 rounded-2xl bg-slate-800 hover:bg-slate-700 text-teal-300 border border-slate-700 text-xs font-bold transition-all hover:scale-105"
          >
            <span>{getUi('exploreDemoData', currentLang)}</span>
          </button>
        </div>

        {/* Terms footer */}
        <div className="pt-4 border-t border-slate-800 text-xs text-slate-400 space-y-2">
          <label className="flex items-center justify-center gap-2 cursor-pointer select-none">
            <input
              type="checkbox"
              checked={agreedTerms}
              onChange={(e) => setAgreedTerms(e.target.checked)}
              className="w-4 h-4 text-teal-600 rounded bg-slate-800 border-slate-700"
            />
            <span>{getUi('acceptTermsCharter', currentLang)}</span>
          </label>

          <button
            onClick={onOpenTerms}
            className="text-[11px] text-teal-400 hover:underline block mx-auto font-mono"
          >
            {getUi('readLegalPolicies', currentLang)}
          </button>
        </div>
      </div>
    </div>
  );
}

import React, { useState } from 'react';
import { 
  CheckCircle2, 
  ArrowRight, 
  ArrowLeft, 
  Globe,
  Sparkles
} from 'lucide-react';
import { languages, translations } from '../i18n/translations';

export default function CustomerRegistrationPage({
  currentLang = 'en',
  onSelectLang,
  onCompleteCustomerRegistration,
  onBackToWelcome,
  onOpenTerms
}) {
  const t = translations[currentLang] || translations.en;

  const [step, setStep] = useState(1);
  const [formData, setFormData] = useState({
    name: '',
    phone: '',
    age: '',
    gender: 'Female',
    address: '',
    city: 'Indiranagar, Bengaluru',
    agreeTerms: true
  });

  const [otp, setOtp] = useState('');
  const [generatedOtp, setGeneratedOtp] = useState('5482');

  const handleSendOtp = (e) => {
    e.preventDefault();
    if (!formData.name.trim() || !formData.phone.trim()) return;
    const newCode = Math.floor(1000 + Math.random() * 9000).toString();
    setGeneratedOtp(newCode);
    setOtp('');
    setStep(2);
  };

  const handleFinish = (e) => {
    e.preventDefault();
    if (!formData.agreeTerms) return;

    onCompleteCustomerRegistration({
      id: `c-${Date.now()}`,
      name: formData.name.trim(),
      phone: formData.phone.trim(),
      age: formData.age || '25',
      gender: formData.gender,
      address: `${formData.address.trim() ? formData.address.trim() + ', ' : ''}${formData.city}`,
      preferredLang: currentLang,
      agreedTermsTimestamp: new Date().toISOString()
    });
  };

  return (
    <div className="min-h-screen bg-slate-900 text-white flex flex-col justify-between p-4 sm:p-8 font-sans">
      <div className="max-w-2xl w-full mx-auto flex items-center justify-between pb-4 border-b border-slate-800">
        <button
          onClick={onBackToWelcome}
          className="bg-slate-800 hover:bg-slate-700 text-white px-3.5 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-colors"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>{t.back}</span>
        </button>

        <div className="flex items-center gap-2">
          <img 
            src="/truewage-logo.jpg" 
            alt="TrueWage Logo" 
            className="w-8 h-8 object-contain rounded-xl bg-white p-0.5 shadow shrink-0" 
          />
          <span className="font-extrabold text-base text-white">TrueWage</span>
        </div>

        <div className="flex items-center bg-slate-800 rounded-xl px-2 py-1 border border-slate-700 text-xs">
          <Globe className="w-3.5 h-3.5 text-teal-400 mr-1" />
          <select
            value={currentLang}
            onChange={(e) => onSelectLang(e.target.value)}
            className="bg-transparent font-bold text-white focus:outline-none cursor-pointer"
          >
            {languages.map((l) => (
              <option key={l.code} value={l.code} className="bg-slate-900 text-white">
                {l.flag} {l.native}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div className="max-w-lg w-full mx-auto my-6 bg-slate-800/90 rounded-3xl p-6 sm:p-8 border border-slate-700 shadow-2xl space-y-6">
        <div className="space-y-1">
          <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-teal-500/20 text-teal-300 border border-teal-500/30 text-[11px] font-bold">
            <Sparkles className="w-3.5 h-3.5 text-teal-400" />
            <span>{t.customerRole}</span>
          </div>
          <h2 className="text-2xl font-black text-white tracking-tight">
            {t.customerReg.pageTitle}
          </h2>
          <p className="text-xs text-slate-400">
            {t.customerReg.pageSubtitle}
          </p>
        </div>

        {step === 1 ? (
          <form onSubmit={handleSendOtp} className="space-y-4 text-xs">
