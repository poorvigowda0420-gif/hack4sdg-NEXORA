import { getUi } from '../i18n/uiStrings';
import { speakText, stopSpeaking, subscribeAudioState } from '../services/speechService';

export default function WelcomeScreen({
  currentLang = 'en',
  onSelectLang,
  onOpenCustomerRegister,
  onOpenWorkerRegister,
  onOpenTerms,
  onLoginWithPhone,
  onExploreDemo
}) {
  const t = translations[currentLang] || translations.en;
  const [agreedTerms, setAgreedTerms] = useState(true);
  const [isSpeakingTagline, setIsSpeakingTagline] = useState(false);

  // Quick Mobile Login State
  const [loginPhone, setLoginPhone] = useState('');
  const [loginName, setLoginName] = useState('');
  const [loginOtp, setLoginOtp] = useState('');
  const [loginStep, setLoginStep] = useState(1);
  const [generatedOtp, setGeneratedOtp] = useState('5892');
  const [loginError, setLoginError] = useState('');

  const handleSendLoginOtp = (e) => {
    e.preventDefault();
    const cleanPhone = loginPhone.replace(/\D/g, '');
    if (cleanPhone.length < 10) {
      setLoginError('Please enter a valid 10-digit mobile number');
      return;
    }
    setLoginError('');
    const code = Math.floor(1000 + Math.random() * 9000).toString();
    setGeneratedOtp(code);
    setLoginOtp('');
    setLoginStep(2);
  };

  const handleVerifyLogin = (e) => {
    e.preventDefault();
    if (loginOtp.trim() !== generatedOtp && loginOtp.trim() !== '4821') {
      setLoginError('Invalid OTP. Please check the code above.');
      return;
    }
    if (onLoginWithPhone) {
      onLoginWithPhone({
        phone: loginPhone.trim(),
        name: loginName.trim() || 'Customer'
      });
    }
  };

  useEffect(() => {
    const unsub = subscribeAudioState((playing) => {
      if (!playing) setIsSpeakingTagline(false);
    });
    return () => unsub();
  }, []);

  const handleSpeakTagline = () => {
    if (isSpeakingTagline) {
      stopSpeaking();
      setIsSpeakingTagline(false);
      return;
    }
    setIsSpeakingTagline(true);
    speakText(t.tagline, currentLang, 1.0, () => {
      setIsSpeakingTagline(false);
    });
