import React, { useState, useEffect } from 'react';
import Navbar from './components/Navbar';
import WelcomeScreen from './components/WelcomeScreen';
import CustomerRegistrationPage from './components/CustomerRegistrationPage';
import WorkerRegistrationPage from './components/WorkerRegistrationPage';
import CustomerHome from './components/CustomerHome';
import WorkerDashboard from './components/WorkerDashboard';
import EarningsDashboard from './components/EarningsDashboard';
import ChatInterface from './components/ChatInterface';
import HistoryAndComplaints from './components/HistoryAndComplaints';
import CustomerPrePaymentRecords from './components/CustomerPrePaymentRecords';
import WorkerProfileModal from './components/WorkerProfileModal';
import AdvancePaymentModal from './components/AdvancePaymentModal';
import BillOnTheSpotModal from './components/BillOnTheSpotModal';
import InvoiceModal from './components/InvoiceModal';
import OneWayCallModal from './components/OneWayCallModal';
import SafetyAndSosModal from './components/SafetyAndSosModal';
import TermsModal from './components/TermsModal';
import AdminDashboard from './components/AdminDashboard';

import { 
  initialWorkers, 
  initialBookings, 
  initialComplaints, 
  initialTransactions, 
  initialMessages 
} from './data/mockData';

export default function TrueWageApp() {
  const getInitialUser = () => {
    try {
      const stored = localStorage.getItem('truewage_user');
      return stored ? JSON.parse(stored) : null;
    } catch (e) {
      return null;
    }
  };

  const getInitialBookings = () => {
    try {
      const stored = localStorage.getItem('truewage_bookings');
      return stored ? JSON.parse(stored) : [];
    } catch (e) {
      return [];
    }
  };

  const getInitialRole = () => {
    try {
      return localStorage.getItem('truewage_role') || 'customer';
    } catch (e) {
      return 'customer';
    }
  };

  // Navigation / View state: if user has a session, go straight to 'app', otherwise 'welcome'
  const [viewMode, setViewMode] = useState(() => (getInitialUser() ? 'app' : 'welcome'));
  const [currentRole, setCurrentRole] = useState(getInitialRole); // 'customer' | 'worker' | 'admin'
  const [activeTab, setActiveTab] = useState('home');
  const [currentLang, setCurrentLang] = useState('en');

  // Core Data Collections (Starts clean for new users!)
  const [workers, setWorkers] = useState(initialWorkers);
  const [bookings, setBookings] = useState(getInitialBookings);
  const [complaints, setComplaints] = useState([]);
  const [transactions, setTransactions] = useState([]);
  const [messages, setMessages] = useState([]);

  // Worker Real-Time Notifications
  const [workerNotifications, setWorkerNotifications] = useState([]);

  // Active User Contexts
  const [currentWorker, setCurrentWorker] = useState(initialWorkers[0]);
  const [customerUser, setCustomerUser] = useState(getInitialUser);
  const [userLocation, setUserLocation] = useState({
    name: 'Indiranagar, Bengaluru',
    lat: 12.9784,
    lng: 77.6408
  });

  // Modal Control States
  const [selectedWorkerForProfile, setSelectedWorkerForProfile] = useState(null);
  const [pendingBookingForAdvance, setPendingBookingForAdvance] = useState(null);
  const [activeBillModalBooking, setActiveBillModalBooking] = useState(null);
  const [activeInvoiceToView, setActiveInvoiceToView] = useState(null);
  const [activeCallBooking, setActiveCallBooking] = useState(null);
  const [isSosOpen, setIsSosOpen] = useState(false);
  const [isTermsOpen, setIsTermsOpen] = useState(false);

  // Incoming booking requests
  const [incomingRequests, setIncomingRequests] = useState([]);

  // --- Handlers ---

  // Real Mobile Phone + OTP Quick Login
  const handleLoginWithPhone = ({ phone, name }) => {
    const existing = getInitialUser();
    const cleanPhone = phone.startsWith('+91') ? phone : `+91 ${phone}`;
    const userToUse = (existing && existing.phone === cleanPhone) ? existing : {
      id: `c-${Date.now()}`,
      name: name || 'Valued Customer',
      phone: cleanPhone,
      address: '#12, Green Park Road, Indiranagar, Bengaluru'
    };

    setCustomerUser(userToUse);
    const existingBookings = (existing && existing.phone === cleanPhone) ? getInitialBookings() : [];
    setBookings(existingBookings);
    setMessages([]);
    setCurrentRole('customer');
    setActiveTab('home');
    setViewMode('app');

    try {
      localStorage.setItem('truewage_user', JSON.stringify(userToUse));
      localStorage.setItem('truewage_bookings', JSON.stringify(existingBookings));
      localStorage.setItem('truewage_role', 'customer');
    } catch (e) {}
  };

  // Explore Demo Account with Sample Bookings
  const handleExploreDemo = () => {
    const demoCust = {
      id: 'c-1',
      name: 'Priya Sharma (Demo)',
      phone: '+91 98450 12345',
      address: '#42, 4th Cross, 12th Main, Indiranagar, Bengaluru'
    };
    setCustomerUser(demoCust);
    setBookings(initialBookings);
    setMessages(initialMessages);
    setTransactions(initialTransactions);
    setComplaints(initialComplaints);
    setCurrentRole('customer');
    setActiveTab('home');
    setViewMode('app');
  };

  // Complete Customer Self-Registration (Brand New Clean Account)
  const handleCompleteCustomerRegistration = (custProfile) => {
    setCustomerUser(custProfile);
    setBookings([]); // Clean, fresh account with 0 bookings!
    setMessages([]);
    setComplaints([]);
    setCurrentRole('customer');
    setActiveTab('home');
    setViewMode('app');

    try {
      localStorage.setItem('truewage_user', JSON.stringify(custProfile));
      localStorage.setItem('truewage_bookings', JSON.stringify([]));
      localStorage.setItem('truewage_role', 'customer');
    } catch (e) {}
  };

  // Complete Worker Self-Registration (With Custom Profession!)
  const handleCompleteWorkerRegistration = (workerProfile) => {
    setWorkers(prev => [workerProfile, ...prev]);
    setCurrentWorker(workerProfile);
    setBookings([]);
    setMessages([]);
    setCurrentRole('worker');
    setActiveTab('dashboard');
    setViewMode('app');

    try {
      localStorage.setItem('truewage_user', JSON.stringify(workerProfile));
      localStorage.setItem('truewage_role', 'worker');
    } catch (e) {}
  };

  // Logout handler - clears session and returns to clean Welcome / Sign-in portal
  const handleLogout = () => {
    try {
      localStorage.removeItem('truewage_user');
      localStorage.removeItem('truewage_bookings');
      localStorage.removeItem('truewage_role');
    } catch (e) {}

    setCustomerUser(null);
    setBookings([]);
    setMessages([]);
    setComplaints([]);
    setViewMode('welcome');
    setActiveTab('home');
    setSelectedWorkerForProfile(null);
    setPendingBookingForAdvance(null);
    setActiveBillModalBooking(null);
    setActiveInvoiceToView(null);
    setActiveCallBooking(null);
  };

  // Sync bookings to localStorage for the active session
  useEffect(() => {
    if (customerUser) {
      try {
        localStorage.setItem('truewage_bookings', JSON.stringify(bookings));
      } catch (e) {}
    }
  }, [bookings, customerUser]);

  // Worker Availability Toggle
  const handleToggleWorkerAvailability = () => {
    const updatedStatus = !currentWorker.isAvailable;
    const updated = { ...currentWorker, isAvailable: updatedStatus };
    setCurrentWorker(updated);
    setWorkers(prev => prev.map(w => w.id === updated.id ? updated : w));
  };

  // Direct Booking Flow: Step 1 (Send Request to Worker - NO advance payment required yet!)
  const handleProceedToBooking = (bookingData) => {
    setSelectedWorkerForProfile(null);

    const newBookingId = `TW-BK-${Math.floor(1000 + Math.random() * 9000)}`;
    const newReqId = `REQ-${Date.now()}`;

    // 1. Notify worker by adding to active incoming requests
    const newReq = {
      id: newReqId,
      bookingId: newBookingId,
      customerId: customerUser?.id || `c-${Date.now()}`,
      customerName: customerUser?.name || 'Customer',
      customerPhone: customerUser?.phone || '+91 98765 00000',
      serviceDescription: bookingData.description,
      approxLocation: `${bookingData.address.split(',')[0]} ~ 0.8 km away`,
      fullAddress: bookingData.address,
      requestedTime: bookingData.preferredDate,
      visitingFee: bookingData.visitingFee,
      workerId: bookingData.workerId,
      workerName: bookingData.workerName,
      profession: bookingData.profession
    };
    setIncomingRequests(prev => [newReq, ...prev]);

    // 2. Add booking in PENDING_WORKER_ACCEPTANCE state
    const newBooking = {
      id: newBookingId,
      requestId: newReqId,
      customerId: customerUser?.id || `c-${Date.now()}`,
      customerName: customerUser?.name || 'Customer',
      customerPhone: customerUser?.phone || '+91 98765 00000',
      workerId: bookingData.workerId,
      workerName: bookingData.workerName,
      profession: bookingData.profession,
      serviceDescription: bookingData.description,
      address: bookingData.address,
      preferredTime: bookingData.preferredDate,
      status: 'PENDING_WORKER_ACCEPTANCE',
      createdAt: new Date().toISOString(),
      arrivalTimestamp: null,
      departureTimestamp: null,
      verifiedInHouseDuration: 'Awaiting Worker Acceptance',
      pricing: {
        baseVisitingFee: bookingData.visitingFee,
        advancePaid: 0,
        advancePaidAt: null,
        laborFee: 0,
        materialsCost: 0,
        platformFee: 0,
        totalAmount: bookingData.visitingFee,
        paymentStatus: 'AWAITING_WORKER_ACCEPTANCE'
      }
    };
    setBookings(prev => [newBooking, ...prev]);

    // Show customer their history/booking tracker
    setActiveTab('history');
  };

  // Direct Booking Flow: Step 2 (Customer pays advance AFTER worker accepts the request)
  const handleAdvancePaymentSuccess = (paymentResult) => {
    setBookings(prev => prev.map(b => {
      if (b.id === paymentResult.bookingId) {
        return {
          ...b,
          status: 'IN_PROGRESS',
          verifiedInHouseDuration: 'Advance Paid - Active Slot',
          pricing: {
            ...b.pricing,
            advancePaid: paymentResult.advancePaid,
            advancePaidAt: new Date().toISOString(),
            paymentStatus: 'ADVANCE_HELD_IN_ESCROW'
          }
        };
      }
      return b;
    }));

    const targetBooking = bookings.find(b => b.id === paymentResult.bookingId) || pendingBookingForAdvance;
    const newPrePaymentNotice = {
      id: `NOTIF-${Date.now()}`,
      type: 'PRE_PAYMENT_RECEIVED',
      bookingId: paymentResult.bookingId,
      customerName: customerUser?.name || 'Customer',
      amount: paymentResult.advancePaid,
      serviceDescription: targetBooking?.serviceDescription || 'Home service repair',
      address: targetBooking?.address || customerUser?.address,
      timestamp: 'Just now',
      date: 'Today',
      read: false,
      utr: paymentResult.transactionRef || paymentResult.utr || `UTR${Math.floor(100000000000 + Math.random() * 900000000000)}`
    };
    setWorkerNotifications(prev => [newPrePaymentNotice, ...prev]);

    setPendingBookingForAdvance(null);
    setActiveTab('prepayments');
  };

  // Worker In-Home Arrival Confirmation
  const handleConfirmArrival = (bookingId) => {
    const now = new Date();
    setBookings(prev => prev.map(b => {
      if (b.id === bookingId) {
        return {
          ...b,
          status: 'IN_PROGRESS',
          arrivalTimestamp: now.toISOString(),
          verifiedInHouseDuration: 'In-House Work Active'
        };
      }
      return b;
    }));
  };

  // Generate Digital Invoice from Bill on the Spot
  const handleGenerateInvoice = (invoiceData) => {
    const departureTime = new Date().toISOString();

    setBookings(prev => prev.map(b => {
      if (b.id === invoiceData.bookingId) {
        return {
          ...b,
          status: 'COMPLETED',
          departureTimestamp: departureTime,
          verifiedInHouseDuration: invoiceData.workDuration,
          invoice: invoiceData,
          pricing: {
            ...b.pricing,
            laborFee: invoiceData.items[0]?.amount || 350,
            materialsCost: invoiceData.items[1]?.amount || 0,
            totalAmount: invoiceData.total,
            balancePayable: invoiceData.balanceDue,
            paymentStatus: invoiceData.paymentStatus
          }
        };
      }
      return b;
    }));

    const newTxn = {
      id: `TXN-${Math.floor(1000 + Math.random() * 9000)}`,
      bookingId: invoiceData.bookingId,
      amount: invoiceData.total,
      type: 'COMPLETED_SERVICE_SETTLEMENT',
      workerRetained: invoiceData.total,
      platformFee: 0,
      utr: `UTR${Math.floor(100000000000 + Math.random() * 900000000000)}`,
      timestamp: new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }),
      status: 'Settled to Worker Bank',
      period: 'TODAY'
    };
    setTransactions(prev => [newTxn, ...prev]);
    setActiveInvoiceToView(invoiceData);
  };

  // Accept Incoming Request (Worker)
  const handleAcceptRequest = (req) => {
    setIncomingRequests(prev => prev.filter(r => r.id !== req.id));

    setBookings(prev => {
      const existing = prev.find(b => b.id === req.bookingId || b.requestId === req.id);
      if (existing) {
        return prev.map(b => b.id === existing.id ? {
          ...b,
          status: 'ACCEPTED_PAYMENT_PENDING',
          verifiedInHouseDuration: 'Accepted - Awaiting Customer Advance Payment',
          pricing: {
            ...b.pricing,
            paymentStatus: 'AWAITING_CUSTOMER_ADVANCE'
          }
        } : b);
      } else {
        const acceptedBooking = {
          id: req.bookingId || `TW-BK-${Math.floor(1000 + Math.random() * 9000)}`,
          requestId: req.id,
          customerId: req.customerId || 'c-1',
          customerName: req.customerName || 'Customer',
          customerPhone: req.customerPhone || '+91 98450 12345',
          workerId: req.workerId || currentWorker.id,
          workerName: req.workerName || currentWorker.name,
          profession: req.profession || currentWorker.profession,
          serviceDescription: req.serviceDescription,
          address: req.fullAddress || '#42, 4th Cross, 12th Main, Indiranagar',
          preferredTime: req.requestedTime,
          status: 'ACCEPTED_PAYMENT_PENDING',
          createdAt: new Date().toISOString(),
          arrivalTimestamp: null,
          departureTimestamp: null,
          verifiedInHouseDuration: 'Accepted - Awaiting Customer Advance Payment',
          pricing: {
            baseVisitingFee: req.visitingFee || 150,
            advancePaid: 0,
            advancePaidAt: null,
            laborFee: 0,
            materialsCost: 0,
            platformFee: 0,
            totalAmount: req.visitingFee || 150,
            paymentStatus: 'AWAITING_CUSTOMER_ADVANCE'
          }
        };
        return [acceptedBooking, ...prev];
      }
    });
  };

  const handleDeclineRequest = (reqId) => {
    setIncomingRequests(prev => prev.filter(r => r.id !== reqId));
  };

  const handleSendMessage = (newMsg) => {
    setMessages(prev => [...prev, newMsg]);
  };

  const handleRebookWorker = (pastBooking) => {
    const targetWorker = workers.find(w => w.id === pastBooking.workerId) || workers[0];
    setSelectedWorkerForProfile(targetWorker);
  };

  const handleCreateComplaint = (newTicket) => {
    setComplaints(prev => [newTicket, ...prev]);
  };

  const handleWorkerReplyComplaint = (ticketId, rebuttalText) => {
    setComplaints(prev => prev.map(c => {
      if (c.id === ticketId) {
        return {
          ...c,
          status: 'Resolution Proposed',
          workerRebuttal: rebuttalText
        };
      }
      return c;
    }));
  };

  const handleApproveWorker = (workerId) => {
    setWorkers(prev => prev.map(w => w.id === workerId ? { ...w, isVerified: true } : w));
  };

  const handleRejectWorker = (workerId) => {
    setWorkers(prev => prev.map(w => w.id === workerId ? { ...w, isVerified: false } : w));
  };

  const handleResolveComplaint = (ticketId) => {
    setComplaints(prev => prev.map(c => c.id === ticketId ? { ...c, status: 'Resolved & Closed' } : c));
  };

  // 1. RENDER WELCOME / FIRST TIME SCREEN
  if (viewMode === 'welcome') {
    return (
      <>
        <WelcomeScreen
          currentLang={currentLang}
          onSelectLang={setCurrentLang}
          onOpenCustomerRegister={() => setViewMode('customer_register')}
          onOpenWorkerRegister={() => setViewMode('worker_register')}
          onOpenTerms={() => setIsTermsOpen(true)}
          onLoginWithPhone={handleLoginWithPhone}
          onExploreDemo={handleExploreDemo}
        />
        <TermsModal
          isOpen={isTermsOpen}
          onClose={() => setIsTermsOpen(false)}
          role={currentRole}
          lang={currentLang}
          alreadyAccepted={true}
        />
      </>
    );
  }

  // 2. RENDER FULL CUSTOMER REGISTRATION PAGE
  if (viewMode === 'customer_register') {
    return (
      <>
        <CustomerRegistrationPage
          currentLang={currentLang}
          onSelectLang={setCurrentLang}
          onCompleteCustomerRegistration={handleCompleteCustomerRegistration}
          onBackToWelcome={() => setViewMode('welcome')}
          onOpenTerms={() => setIsTermsOpen(true)}
        />
        <TermsModal
          isOpen={isTermsOpen}
          onClose={() => setIsTermsOpen(false)}
          role="customer"
          lang={currentLang}
          alreadyAccepted={true}
        />
      </>
    );
  }

  // 3. RENDER FULL WORKER REGISTRATION PAGE
  if (viewMode === 'worker_register') {
    return (
      <>
        <WorkerRegistrationPage
          currentLang={currentLang}
          onSelectLang={setCurrentLang}
          onCompleteWorkerRegistration={handleCompleteWorkerRegistration}
          onBackToWelcome={() => setViewMode('welcome')}
          onOpenTerms={() => setIsTermsOpen(true)}
        />
        <TermsModal
          isOpen={isTermsOpen}
          onClose={() => setIsTermsOpen(false)}
          role="worker"
          lang={currentLang}
          alreadyAccepted={true}
        />
      </>
    );
  }

  // 4. MAIN APP VIEW
  return (
    <div className="min-h-screen bg-slate-100 text-slate-900 font-sans flex flex-col justify-between">
      {/* GLOBAL NAVBAR */}
      <Navbar
        currentRole={currentRole}
        setCurrentRole={setCurrentRole}
        activeTab={activeTab}
        setActiveTab={setActiveTab}
        currentLang={currentLang}
        setCurrentLang={setCurrentLang}
        onTriggerSos={() => setIsSosOpen(true)}
        unreadMessages={1}
        workerUnreadNotifs={workerNotifications.filter(n => !n.read).length}
        onOpenTerms={() => setIsTermsOpen(true)}
        onLogout={handleLogout}
      />

      {/* MAIN CONTAINER */}
      <main className="max-w-6xl w-full mx-auto px-3 sm:px-6 pt-4 flex-1">
        {currentRole === 'customer' && (
          <>
            {activeTab === 'home' && (
              <CustomerHome
                workers={workers}
                bookings={bookings}
                onSelectWorker={(w) => setSelectedWorkerForProfile(w)}
                onBookWorker={(w) => setSelectedWorkerForProfile(w)}
                onPayAdvance={(b) => setPendingBookingForAdvance(b)}
                currentLang={currentLang}
                userLocation={userLocation}
                setUserLocation={setUserLocation}
              />
            )}

            {activeTab === 'prepayments' && (
              <CustomerPrePaymentRecords
                bookings={bookings}
                currentLang={currentLang}
                onPayAdvance={(b) => setPendingBookingForAdvance(b)}
                onNavigateToChat={() => setActiveTab('chat')}
                onNavigateToHistory={() => setActiveTab('history')}
                onCreateDispute={(record) => setActiveTab('complaints')}
              />
            )}

            {activeTab === 'chat' && (
              <div className="py-2">
                <ChatInterface
                  currentUserRole="customer"
                  currentLang={currentLang}
                  workerLang={currentWorker.languages?.[0] || 'kn'}
                  customerLang={currentLang}
                  activeBooking={bookings[0]}
                  messages={messages}
                  onSendMessage={handleSendMessage}
                  onInitiateCall={() => alert("Direct outbound calling is restricted for customer.")}
                />
              </div>
            )}

            {(activeTab === 'history' || activeTab === 'complaints') && (
              <HistoryAndComplaints
                currentUserRole="customer"
                bookings={bookings}
                complaints={complaints}
                onPayAdvance={(b) => setPendingBookingForAdvance(b)}
                onRebookWorker={handleRebookWorker}
                onViewInvoice={(inv) => setActiveInvoiceToView(inv)}
                onCreateComplaint={handleCreateComplaint}
                onWorkerReplyComplaint={handleWorkerReplyComplaint}
                currentLang={currentLang}
              />
            )}
          </>
        )}

        {currentRole === 'worker' && (
          <>
            {activeTab === 'dashboard' && (
              <WorkerDashboard
                worker={currentWorker}
                bookings={bookings}
                incomingRequests={incomingRequests}
                notifications={workerNotifications}
                onMarkNotificationRead={(id) => setWorkerNotifications(prev => prev.map(n => n.id === id ? { ...n, read: true } : n))}
                onAcceptRequest={handleAcceptRequest}
                onDeclineRequest={handleDeclineRequest}
                onConfirmArrival={handleConfirmArrival}
                onOpenBillModal={(b) => setActiveBillModalBooking(b)}
                onToggleAvailability={handleToggleWorkerAvailability}
                onOpenChat={() => setActiveTab('chat')}
                onInitiateCall={(b) => setActiveCallBooking(b)}
                currentLang={currentLang}
              />
            )}

            {activeTab === 'earnings' && (
              <EarningsDashboard
                worker={currentWorker}
                transactions={transactions}
                currentLang={currentLang}
                onTriggerPayout={() => {}}
              />
            )}

            {activeTab === 'chat' && (
              <div className="py-2">
                <ChatInterface
                  currentUserRole="worker"
                  currentLang={currentLang}
                  workerLang={currentLang}
                  customerLang={customerUser?.preferredLang || 'en'}
                  activeBooking={bookings[0]}
                  messages={messages}
                  onSendMessage={handleSendMessage}
                  onInitiateCall={(b) => setActiveCallBooking(b || bookings[0])}
                />
              </div>
            )}

            {activeTab === 'history' && (
              <HistoryAndComplaints
                currentUserRole="worker"
                bookings={bookings}
                complaints={complaints}
                onRebookWorker={handleRebookWorker}
                onViewInvoice={(inv) => setActiveInvoiceToView(inv)}
                onCreateComplaint={handleCreateComplaint}
                onWorkerReplyComplaint={handleWorkerReplyComplaint}
                currentLang={currentLang}
              />
            )}
          </>
        )}

        {currentRole === 'admin' && (
          <AdminDashboard
            workers={workers}
            bookings={bookings}
            complaints={complaints}
            onApproveWorker={handleApproveWorker}
            onRejectWorker={handleRejectWorker}
            onResolveComplaint={handleResolveComplaint}
            currentLang={currentLang}
          />
        )}
      </main>

      {/* MODALS */}
      {selectedWorkerForProfile && (
        <WorkerProfileModal
          worker={selectedWorkerForProfile}
          isOpen={Boolean(selectedWorkerForProfile)}
          onClose={() => setSelectedWorkerForProfile(null)}
          onProceedToBooking={handleProceedToBooking}
          currentLang={currentLang}
          customerAddress={customerUser?.address || 'Indiranagar, Bengaluru'}
        />
      )}

      {pendingBookingForAdvance && (
        <AdvancePaymentModal
          isOpen={Boolean(pendingBookingForAdvance)}
          onClose={() => setPendingBookingForAdvance(null)}
          bookingDetails={pendingBookingForAdvance}
          onPaymentSuccess={handleAdvancePaymentSuccess}
          currentLang={currentLang}
        />
      )}

      {activeBillModalBooking && (
        <BillOnTheSpotModal
          isOpen={Boolean(activeBillModalBooking)}
          onClose={() => setActiveBillModalBooking(null)}
          booking={activeBillModalBooking}
          onGenerateInvoice={handleGenerateInvoice}
          currentLang={currentLang}
        />
      )}

      {activeInvoiceToView && (
        <InvoiceModal
          isOpen={Boolean(activeInvoiceToView)}
          onClose={() => setActiveInvoiceToView(null)}
          invoiceData={activeInvoiceToView}
          currentLang={currentLang}
        />
      )}

      {activeCallBooking && (
        <OneWayCallModal
          isOpen={Boolean(activeCallBooking)}
          onClose={() => setActiveCallBooking(null)}
          booking={activeCallBooking}
          currentLang={currentLang}
        />
      )}

      {isSosOpen && (
        <SafetyAndSosModal
          isOpen={isSosOpen}
          onClose={() => setIsSosOpen(false)}
          currentLang={currentLang}
          userCoords={{
            lat: userLocation.lat,
            lng: userLocation.lng,
            address: `${userLocation.name}, Karnataka, India`
          }}
        />
      )}

      {isTermsOpen && (
        <TermsModal
          isOpen={isTermsOpen}
          onClose={() => setIsTermsOpen(false)}
          role={currentRole}
          lang={currentLang}
          alreadyAccepted={true}
        />
      )}
    </div>
  );
}

import React, { useState, useEffect } from 'react';
import { 
  ShieldCheck, 
  Globe, 
  Wrench, 
  Volume2, 
  Square,
  ArrowRight, 
  UserPlus,
  Phone,
  Sparkles,
  KeyRound,
  CheckCircle2
} from 'lucide-react';
