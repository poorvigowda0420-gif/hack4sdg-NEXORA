                <option value="Koramangala, Bengaluru">Koramangala, Bengaluru</option>
                <option value="Whitefield, Bengaluru">Whitefield, Bengaluru</option>
                <option value="Jayanagar, Bengaluru">Jayanagar, Bengaluru</option>
